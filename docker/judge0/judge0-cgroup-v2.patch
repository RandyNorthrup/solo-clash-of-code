-    #{submission.enable_per_process_and_thread_memory_limit ? "-m " : "--cg-mem="}#{submission.memory_limit} \
+    #{cg_timing_flag_for(submission)} \
+    #{cg_memory_flag_for(submission.memory_limit)} \
     -f #{submission.max_file_size} \
