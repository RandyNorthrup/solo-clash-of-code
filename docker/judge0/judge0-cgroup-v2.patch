+require "rubygems/version"
+
 class IsolateJob < ApplicationJob
   retry_on RuntimeError, wait: 0.1.seconds, attempts: 100
 
   queue_as ENV["JUDGE0_VERSION"].to_sym
 
+  MIN_VERSION_WITHOUT_CG_TIMING = Gem::Version.new("2.0.0")
+  COMPILATION_CPU_TIME_LIMIT_SECONDS = 30
+  COMPILATION_WALL_TIME_LIMIT_SECONDS = 60
+  ISOLATE_BOX_COUNT = 1000
+  ISOLATE_VERSION = begin
+    version_line = `isolate --version 2>/dev/null`.lines.first.to_s
+    version_match = version_line[/\d+\.\d+(?:\.\d+)?/]
+    raise "Judge0 startup failed: cannot determine isolate version." if version_match.nil?
+    Gem::Version.new(version_match)
+  end
+  CG_TIMING_SUPPORTED = ISOLATE_VERSION < MIN_VERSION_WITHOUT_CG_TIMING
+
   STDIN_FILE_NAME = "stdin.txt"
   STDOUT_FILE_NAME = "stdout.txt"
   STDERR_FILE_NAME = "stderr.txt"
@@ -52,9 +66,17 @@ class IsolateJob < ApplicationJob
 
   private
 
+  CGROUP_V1_MEMORY_PATH = "/sys/fs/cgroup/memory".freeze
+  CGROUP_V2_CONTROLLERS_PATH = "/sys/fs/cgroup/cgroup.controllers".freeze
+
+  def self.cgroups_supported?
+    File.directory?(CGROUP_V1_MEMORY_PATH) || File.exist?(CGROUP_V2_CONTROLLERS_PATH)
+  end
+
   def initialize_workdir
-    @box_id = submission.id%2147483647
+    @box_id = submission.id % ISOLATE_BOX_COUNT
-    @cgroups = (!submission.enable_per_process_and_thread_time_limit || !submission.enable_per_process_and_thread_memory_limit) ? "--cg" : ""
+    requires_cgroups = !submission.enable_per_process_and_thread_time_limit || !submission.enable_per_process_and_thread_memory_limit
+    @cgroups = self.class.cgroups_supported? && requires_cgroups ? "--cg" : ""
     @workdir = `isolate #{cgroups} -b #{box_id} --init`.chomp
     @boxdir = workdir + "/box"
     @tmpdir = workdir + "/tmp"
@@ -93,8 +115,8 @@ class IsolateJob < ApplicationJob
     -w 4 \
