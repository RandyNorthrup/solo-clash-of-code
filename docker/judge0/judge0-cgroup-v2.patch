@@ -349,4 +371,21 @@ class IsolateJob < ApplicationJob
   rescue ArgumentError
     return text
   end
+
+  def cg_timing_flag_for(submission)
+    return "" unless cgroups.present? && CG_TIMING_SUPPORTED
+
+    if submission.enable_per_process_and_thread_time_limit
+      "--no-cg-timing"
+    else
+      "--cg-timing"
+    end
+  end
+
+  def cg_memory_flag_for(limit)
+    return "-m #{limit}" if submission.enable_per_process_and_thread_memory_limit
+    return "" unless cgroups.present?
+
+    "--cg-mem=#{limit}"
+  end
 end
